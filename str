# Fonction pour créer une carte HTML
def render_card(title, value, delta, delta_color, icon, icon_bg):
    html = f"""
    <div class="metric-card">
        <div class="metric-header">{title}</div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <div class="metric-value">{value}</div>
            <div style="background-color: {icon_bg}; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white;">
                {icon}
            </div>
        </div>
        <div class="{delta_color}" style="margin-top: 10px;">{delta} <span style="color: grey; font-weight: normal;">SINCE LAST MONTH</span></div>
    </div>
    """
    st.markdown(html, unsafe_allow_html=True)

